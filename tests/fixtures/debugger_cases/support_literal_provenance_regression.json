{
  "name": "support_literal_provenance_regression",
  "description": "A support-control atom may recover the rules defining a literal, but it must not promote that literal to Selected Literals; aggregate rule-to-literal substitutions are shown only after validating the alternative core.",
  "program": "a1 | a2.\na2 | a3.\na4 | a5.\n{a6}.\n:- not a4, #count{a1:a1;a2:a2;a3:a3;a6:a6}>=2.\n",
  "debug_rules": true,
  "debug_answer_set": true,
  "answer_set_count": 0,
  "answer_set_index": 1,
  "expected_answer_sets": [
    ["a1", "a3", "a4"],
    ["a1", "a3", "a4", "a6"],
    ["a2", "a5"],
    ["a2", "a4"],
    ["a2", "a4", "a6"]
  ],
  "expected_atoms": [
    {"atom": "a1", "value": "true"},
    {"atom": "a3", "value": "true"},
    {"atom": "a4", "value": "true"},
    {"atom": "a6", "value": "true"},
    {"atom": "a5", "value": "false"}
  ],
  "explanations": [
    {
      "literal": "not a5",
      "expected_responses": [
        {"type": "literal", "rule": "a1."},
        {"type": "literal", "rule": "a3."},
        {"type": "aggregate", "rule": ":- not a4, #count{a1:a1;a2:a2;a3:a3;a6:a6}>=2."},
        {"type": "rule", "rule": "a4 | a5."}
      ]
    }
  ]
}
